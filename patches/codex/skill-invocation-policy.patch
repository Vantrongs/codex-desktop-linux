+pub fn apply_implicit_invocation_overrides(skills: &mut [SkillMetadata], rules: &SkillConfigRules) {
+    for entry in &rules.entries {
+        let Some(allow_implicit_invocation) = entry.allow_implicit_invocation else {
+            continue;
+        };
+        for skill in skills.iter_mut().filter(|skill| match &entry.selector {
+            SkillConfigRuleSelector::Path(path) => skill.path_to_skills_md == *path,
+            SkillConfigRuleSelector::Name(name) => skill.name == *name,
+        }) {
+            skill
+                .policy
+                .get_or_insert_default()
+                .allow_implicit_invocation = Some(allow_implicit_invocation);
+        }
+    }
+}
