+#[derive(Debug, Args)]
+struct MigrateRolloutsCommand {
+    /// Apply the migration. Without this flag, only eligible rollouts are reported.
+    #[arg(long)]
+    apply: bool,
+
+    /// Restrict the operation to one or more thread IDs.
+    #[arg(long = "thread-id", value_name = "THREAD_ID", value_parser = parse_thread_id)]
+    thread_ids: Vec<ThreadId>,
+
+    /// Maximum migration throughput in MiB/s.
+    #[arg(long, default_value_t = 8)]
+    max_mib_per_second: u64,
+}
+
+fn parse_thread_id(value: &str) -> Result<ThreadId, String> {
+    ThreadId::from_string(value).map_err(|error| format!("invalid thread id `{value}`: {error}"))
+}
