+/// Inspect or atomically migrate selected local legacy rollouts to paginated history.
+pub async fn migrate_local_rollouts(
+    config: &Config,
+    options: RolloutMigrationOptions,
+) -> anyhow::Result<RolloutMigrationReport> {
+    let store_config = LocalThreadStoreConfig::from_config(config);
+    let state_db = match options.mode {
+        RolloutMigrationMode::DryRun => None,
+        RolloutMigrationMode::Apply => Some(
+            StateRuntime::init(
+                store_config.sqlite.clone(),
+                store_config.default_model_provider_id.clone(),
+            )
+            .await?,
+        ),
+    };
+    let store = LocalThreadStore::new(store_config, state_db);
+    Ok(store.migrate_rollouts(options).await?)
+}
