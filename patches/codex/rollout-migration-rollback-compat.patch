+async fn migration_trims_approved_command_context_with_rolled_back_turn() {
+    let home = TempDir::new().expect("create Codex home");
+    let thread_id = ThreadId::new();
+    let path = write_rollout(
+        home.path(),
+        thread_id,
+        SessionSource::Cli,
+        vec![
+            rollout_response_item(input_response_message("user", "keep question")),
+            rollout_response_item(input_response_message("assistant", "keep answer")),
+            rollout_response_item(input_response_message(
+                "developer",
+                "Approved command prefix saved:\n- [\"cargo\", \"test\"]",
+            )),
+            rollout_response_item(input_response_message("user", "remove question")),
+            RolloutItem::EventMsg(EventMsg::ThreadRolledBack(ThreadRolledBackEvent {
+                num_turns: 1,
+            })),
+            user_message("replacement question"),
+        ],
+    );
+    let store = indexed_store(home.path()).await;
+
+    store
+        .migrate_rollouts(apply_options())
+        .await
+        .expect("migrate approved-prefix rollback");
+
+    assert!(!read_rollout(&path).iter().any(|line| {
+        matches!(
+            &line.item,
+            RolloutItem::ResponseItem(response)
+                if matches!(
+                    &response.item,
+                    ResponseItem::Message { role, content, .. }
+                        if role == "developer"
+                            && content.iter().any(|item| matches!(
+                                item,
+                                ContentItem::InputText { text }
+                                    if text.starts_with("Approved command prefix saved:")
+                            ))
+                )
+        )
+    }));
+}
