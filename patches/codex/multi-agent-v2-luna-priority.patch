+#[test]
+fn spawn_agent_v2_override_tool_exposes_luna_and_service_tier_without_changing_reserved_schema() {
+    let mut luna = model_preset("luna", /*show_in_picker*/ true);
+    luna.model = "gpt-5.6-luna".to_string();
+    luna.multi_agent_version = Some(MultiAgentVersion::V1);
+    let tool = create_spawn_agent_v2_override_tool(SpawnAgentToolOptions {
+        available_models: vec![luna],
+        agent_type_description: "role help".to_string(),
+        expose_agent_type: false,
+        hide_agent_type_model_reasoning: true,
+        expose_spawn_agent_model_overrides: false,
+        multi_agent_version: MultiAgentVersion::V2,
+        usage_hint_text: None,
+    });
+
+    let ToolSpec::Function(ResponsesApiTool {
+        name,
+        description,
+        parameters,
+        ..
+    }) = tool
+    else {
+        panic!("spawn_agent_v2 should be a function tool");
+    };
+    let properties = parameters
+        .properties
+        .as_ref()
+        .expect("spawn_agent_v2 should use object params");
+
+    assert_eq!(name, "spawn_agent_v2");
+    assert!(!properties.contains_key("agent_type"));
+    for property in ["model", "reasoning_effort", "service_tier"] {
+        assert!(properties.contains_key(property));
+    }
+    assert!(description.contains("`gpt-5.6-luna`"));
+}
