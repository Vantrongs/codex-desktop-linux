 #[tokio::test]
+async fn migration_preserves_legacy_generated_thread_name() {
+    let home = TempDir::new().expect("create Codex home");
+    let thread_id = ThreadId::new();
+    write_rollout(
+        home.path(),
+        thread_id,
+        SessionSource::Cli,
+        vec![
+            user_message("full first user request"),
+            agent_message("first answer"),
+        ],
+    );
+    append_thread_name(home.path(), thread_id, "Generated short title")
+        .await
+        .expect("record generated legacy name");
+    let store = indexed_store(home.path()).await;
+
+    let before = store
+        .state_db()
+        .await
+        .expect("state db")
+        .get_thread(thread_id)
+        .await
+        .expect("read metadata")
+        .expect("thread metadata");
+    assert_eq!(before.title, "full first user request");
+    assert_eq!(before.name, None);
+
+    store
+        .migrate_rollouts(apply_options())
+        .await
+        .expect("migrate named legacy rollout");
+
+    let after = store
+        .state_db()
+        .await
+        .expect("state db")
+        .get_thread(thread_id)
+        .await
+        .expect("read migrated metadata")
+        .expect("migrated thread metadata");
+    assert_eq!(after.history_mode, ThreadHistoryMode::Paginated);
+    assert_eq!(after.name.as_deref(), Some("Generated short title"));
+}
